rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /favorites/{movieId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Reviews a user opted to share. Readable by anyone, writable only by the
    // author, and one document per user per movie.
    match /movieReviews/{movieId}/reviews/{userId} {
      function isAuthor() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isValidReview() {
        let data = request.resource.data;
        return data.userId == userId
          && data.imdbID == movieId
          && data.note is string
          && data.note.size() > 0
          && data.note.size() <= 500
          && data.displayName is string
          && data.displayName.size() <= 100
          && (data.rating == null || (data.rating is int && data.rating >= 1 && data.rating <= 10));
      }

      allow read: if true;
      allow create, update: if isAuthor() && isValidReview();
      allow delete: if isAuthor();
    }
  }
}
